# Data ownership has no independent numerical profile or runtime unlock. Record
# its configured sources/flags and the genuine numerical parent separately.
include_guard(GLOBAL)

function(pikapika_add_world_static_mesh_session target scheduler_target)
  if(TARGET "${target}" OR NOT TARGET "${scheduler_target}")
    message(FATAL_ERROR "Owned session needs a new target and an existing packet scheduler")
  endif()
  get_target_property(source_set "${scheduler_target}" PIKAPIKA_CONTROLLED_SCHEDULER_SOURCE_SET)
  if(NOT source_set STREQUAL "world-static-mesh-flight-controlled-scheduler-v1")
    message(FATAL_ERROR "Owned session requires the genuine numerical parent")
  endif()
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(header "core/include/pikapika/world_static_mesh_session.hpp")
  set(source "core/src/world_static_mesh_session.cpp")
  file(SHA256 "${root}/${header}" header_hash)
  file(SHA256 "${root}/${source}" source_hash)
  file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" helper_hash)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${root}/${header}" "${root}/${source}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(configurations "${CMAKE_CONFIGURATION_TYPES}")
  if(NOT configurations)
    if(NOT CMAKE_BUILD_TYPE)
      message(FATAL_ERROR "Owned session requires an explicit configuration")
    endif()
    set(configurations "${CMAKE_BUILD_TYPE}")
  endif()
  # Read the existing definitions exactly; never change the parent helper/IDs.
  _pikapika_packet_upstream(parent_expression parent_profile "${scheduler_target}"
    PIKAPIKA_CONTROLLED_SCHEDULER "${configurations}")
  if(MSVC)
    set(options /W4 /WX /permissive- /fp:strict /GL-)
    set(link_options /LTCG:OFF)
  else()
    set(options -Wall -Wextra -Wpedantic -Werror -fno-fast-math -ffp-contract=off -frounding-math -fno-lto)
    set(link_options -fno-lto)
  endif()
  add_library("${target}" STATIC "${root}/${header}" "${root}/${source}")
  target_include_directories("${target}" PUBLIC "${root}/core/include")
  target_link_libraries("${target}" PUBLIC "${scheduler_target}")
  target_compile_options("${target}" PRIVATE ${options})
  target_link_options("${target}" INTERFACE ${link_options})
  set_property(TARGET "${target}" PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
  set_property(TARGET "${target}" PROPERTY PIKAPIKA_SESSION_SOURCE_SET "world-static-mesh-session-owner-v1")
  set(flags_json "[")
  set(separator "")
  foreach(option IN LISTS options)
    _pikapika_controlled_scheduler_json_quote(encoded "${option}")
    string(APPEND flags_json "${separator}${encoded}")
    set(separator ",")
  endforeach()
  string(APPEND flags_json "]")
  foreach(configuration IN LISTS configurations)
    _pikapika_packet_config_id(parent_id "${parent_expression}" "${configuration}")
    set(numerical_profile 0)
    if(configuration STREQUAL "Release" AND parent_profile)
      set(numerical_profile 1)
    endif()
    string(TOUPPER "${configuration}" upper_config)
    set(material "{\"identitySchema\":1,\"sourceSet\":\"world-static-mesh-session-owner-v1\"")
    foreach(pair IN ITEMS
        "configuration|${configuration}" "compilerId|${CMAKE_CXX_COMPILER_ID}" "compilerVersion|${CMAKE_CXX_COMPILER_VERSION}"
        "compilerPath|${CMAKE_CXX_COMPILER}" "system|${CMAKE_SYSTEM_NAME}" "architecture|${CMAKE_SYSTEM_PROCESSOR}"
        "generator|${CMAKE_GENERATOR}" "generatorPlatform|${CMAKE_GENERATOR_PLATFORM}" "pointerBytes|${CMAKE_SIZEOF_VOID_P}"
        "globalFlags|${CMAKE_CXX_FLAGS}" "configurationFlags|${CMAKE_CXX_FLAGS_${upper_config}}"
        "runtimeLibrary|${CMAKE_MSVC_RUNTIME_LIBRARY}" "helperSha256|${helper_hash}" "numericalParentBuildId|${parent_id}")
      string(FIND "${pair}" "|" at)
      string(SUBSTRING "${pair}" 0 ${at} key)
      math(EXPR start "${at}+1")
      string(SUBSTRING "${pair}" ${start} -1 value)
      _pikapika_controlled_scheduler_json_quote(encoded "${value}")
      string(APPEND material ",\"${key}\":${encoded}")
    endforeach()
    string(APPEND material ",\"numericalParentProfile\":${numerical_profile},\"compileOptions\":${flags_json},\"IPO\":false,\"sources\":[{\"path\":\"${header}\",\"sha256\":\"${header_hash}\",\"flags\":[]},{\"path\":\"${source}\",\"sha256\":\"${source_hash}\",\"flags\":${flags_json}}]}")
    string(SHA256 identity "${material}")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/world-owned-session-configuration-${configuration}.json"
      CONTENT "{\n\"schema\":1,\n\"configuredSource\":true,\n\"configurationId\":\"${identity}\",\n\"identityMaterial\":${material},\n\"artifactAuditComplete\":false,\n\"scope\":\"Configured ownership sources/compiler/flags and numerical parent reference. No independent runtime numerical profile, object inspection, heap or complete clock/commit proof.\"\n}\n"
      CONDITION "$<CONFIG:${configuration}>")
  endforeach()
endfunction()
