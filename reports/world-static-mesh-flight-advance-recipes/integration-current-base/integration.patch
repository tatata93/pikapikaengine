+foreach(PP_WF_SOURCE IN LISTS PP_WF_SOURCES)
   file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${PP_WF_SOURCE}" PP_WF_HASH)
   string(APPEND PP_WF_SOURCE_IDENTITIES "${PP_WF_SOURCE}:${PP_WF_HASH};")
   if(PP_WF_SOURCE MATCHES "\\.hpp$")
     set(PP_WF_ROW_FLAGS "[]")
